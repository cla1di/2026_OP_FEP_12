#include <stdio.h>
#include <math.h>
int main(void) {
double a, b, c;
double d, x1, x2;
printf("Введіть коефіцієнти a, b та c: ");
scanf("%lf %lf %lf", &a, &b, &c);
if (a == 0) {
printf("Коефіцієнт 'a' не може дорівнювати нулю!\n");
return 1;
}
d = (b * b) - (4 * a * c);
printf("Дискримінант (D) = %.2f\n", d);
if (d > 0) {
x1 = (-b + sqrt(d)) / (2 * a);
x2 = (-b - sqrt(d)) / (2 * a);
printf("Рівняння має два дійсні корені:\n");
printf("x1 = %.2f\n", x1);
printf("x2 = %.2f\n", x2);
}
else if (d == 0) {
x1 = -b / (2 * a);
printf("Рівняння має один корінь:\n");
printf("x1 = x2 = %.2f\n", x1);
}
else {
printf("Дискримінант від'ємний! Дійсних коренів немає.\n");
}
return 0;
}
