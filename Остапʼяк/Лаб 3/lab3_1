#include <stdio.h>
int main() {
int num = 255;
float real_num = 123.456;
char ch = 'A';
char str[] = "Hello, World!";
void *ptr = &num;
// Виведення цілого числа
printf("Ціле число у десятковому форматі: %d\n" , num);
printf("Ціле число у вісімковому форматі: %o\n" , num);
printf("Ціле число у шістнадцятковому форматі: %x\n" , num);
// Виведення числа у двійковому форматі
printf("Ціле число у двійковому форматі: ");
for (int i = sizeof(num) * 8 - 1; i >= 0; i--) {
printf("%d" , (num >> i) & 1);
}
printf("\n");// Виведення дійсного числа
printf("Дійсне число у форматі з плаваючою комою: %f\n" , real_num);
printf("Дійсне число в експоненційній формі: %e\n" , real_num);
printf("Дійсне число у гнучкій формі (g): %g\n" , real_num);
// Виведення символу, стрічки і вказівника
printf("Символ: %c\n" , ch);
printf("Стрічка: %s\n" , str);
printf("Вказівник: %p\n" , ptr);
return 0;
}