char surnames[MAX_PEOPLE][MAX_LENGTH];
char initials[MAX_PEOPLE][MAX_LENGTH];
char emails[MAX_PEOPLE][MAX_LENGTH];
char favorite_colors[MAX_PEOPLE][MAX_LENGTH];// Введення даних для
кожної особи
for (int i = 0; i < MAX_PEOPLE; i++) {
printf("Введіть прізвище для особи %d: ", i + 1);
fgets(surnames[i], MAX_LENGTH, stdin);
