}
printf("%-5s %-20s %-10s %-30s %-15s\n", "№ п/п", "Прізвище", "Ініціали",
"Ел.пошта",
"Улюблений колір");
printf("-----------------------------------------------------------------------------\n");
// Виведення даних у форматованому вигляді
for (int i = 0; i < MAX_PEOPLE; i++) {
printf("%-5d %-20s %-10s %-30s %-15s\n",
i + 1,
surnames[i],
initials[i],
emails[i],
favorite_colors[i]);
}
